  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/villavic/pi-stuff.git",
    "directory": "extensions/pi-prompt-rewriter"
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "system-prompt",
    "tool-description"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "changelogPath": "./CHANGELOG.md"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
